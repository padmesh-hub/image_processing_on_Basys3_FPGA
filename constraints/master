## ====================================================================
## CLOCK SIGNAL CONSTRAINTS
## ====================================================================
## Target Input Clock: 100 MHz (10ns Period)
set_property -dict { PACKAGE_PIN W5   IOSTANDARD LVCMOS33 } [get_ports Clock_In_100_MHz]
create_clock -add -name sys_clk_pin -period 10.00 -waveform {0 5} [get_ports Clock_In_100_MHz]


## ====================================================================
## INPUT PORTS CONSTRAINTS
## ====================================================================
## Reset Signal (e.g., Push Button)
set_property -dict { PACKAGE_PIN U18   IOSTANDARD LVCMOS33 } [get_ports Reset]

## UART Serial RX Data Line (e.g., USB-UART Bridge Pin or Pmod)
set_property -dict { PACKAGE_PIN B18   IOSTANDARD LVCMOS33 } [get_ports RX_Dataline]

## VGA Start Signal Control (e.g., Slide Switch)
set_property -dict { PACKAGE_PIN V17   IOSTANDARD LVCMOS33 } [get_ports VGA_Start]


## ====================================================================
## OUTPUT PORTS CONSTRAINTS - VGA VIDEO SIGNALS
## ====================================================================
## VGA Synchronization Pins
set_property -dict { PACKAGE_PIN P19   IOSTANDARD LVCMOS33 } [get_ports Hsync]
set_property -dict { PACKAGE_PIN R19   IOSTANDARD LVCMOS33 } [get_ports Vsync]

## VGA Data Color Output Bits (12-bit total color architecture)
## Red Channels (4-bits)
set_property -dict { PACKAGE_PIN G19   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[8]}]
set_property -dict { PACKAGE_PIN H19   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[9]}]
set_property -dict { PACKAGE_PIN J19   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[10]}]
set_property -dict { PACKAGE_PIN N19   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[11]}]

## Green Channels (4-bits)
set_property -dict { PACKAGE_PIN J17   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[4]}]
set_property -dict { PACKAGE_PIN H17   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[5]}]
set_property -dict { PACKAGE_PIN G17   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[6]}]
set_property -dict { PACKAGE_PIN D17   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[3]}]

## Blue Channels (4-bits)
set_property -dict { PACKAGE_PIN N18   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[0]}]
set_property -dict { PACKAGE_PIN L18   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[1]}]
set_property -dict { PACKAGE_PIN K18   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[2]}]
set_property -dict { PACKAGE_PIN J18   IOSTANDARD LVCMOS33 } [get_ports {Data_Out[7]}]


## ====================================================================
## CONFIGURATION CONSTRAINTS FOR VIVADO IMPLEMENTATION
## ====================================================================
## Ensures bitstream compression rules and voltage properties match general Artix-7 standard dev boards
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
